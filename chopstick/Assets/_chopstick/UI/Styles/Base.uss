/* Base: raiz, pantallas, tipografia y utilidades */
.app { flex-grow: 1; background-color: var(--bg); }
.app > TemplateContainer { position: absolute; left: 0; right: 0; top: 0; bottom: 0; }
.screen {
    flex-grow: 1;
    padding: 28px 22px; flex-direction: column; background-color: var(--bg);
}
.title { font-size: 34px; -unity-font-style: bold; -unity-text-align: middle-center; color: var(--ink); margin-top: 8px; }
.subtitle { font-size: 14px; color: var(--mute); -unity-text-align: middle-center; white-space: normal; margin-bottom: 14px; }
.text { font-size: 15px; color: var(--ink); white-space: normal; }
.text--bold { -unity-font-style: bold; }
.text--mute { color: var(--mute); }
.text--center { -unity-text-align: middle-center; }
.spacer { flex-grow: 1; }
.row { flex-direction: row; }
