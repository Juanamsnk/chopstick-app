/* Menu principal, pantalla Jugar y Ajustes */

/* Barra superior: perfil a la izquierda y Ajustes a la derecha */
.topbar { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.topbar__btn {
    background-color: var(--card-2); color: var(--ink); border-width: 2px; border-bottom-width: 4px; border-color: var(--card-2-depth);
    border-radius: 16px; padding: 6px 14px; margin: 0; font-size: 14px; -unity-font-style: bold; min-height: 40px;
}
.topbar__btn:hover, .topbar__btn:focus { background-color: var(--card-2); border-color: var(--card-2-depth); }
.topbar__btn:active { translate: 0 2px; border-bottom-width: 2px; }

.profile-pill {
    flex-direction: row; align-items: center; margin: 0;
    background-color: var(--card); border-width: 2px; border-bottom-width: 4px; border-color: var(--line);
    border-radius: 24px; padding: 4px 16px 4px 4px;
}
.profile-pill:hover, .profile-pill:focus { background-color: var(--card); border-color: var(--line); }
.profile-pill:active { translate: 0 2px; border-bottom-width: 2px; }
.profile-pill__info { margin-left: 8px; }
.profile-pill__name { font-size: 14px; -unity-font-style: bold; color: var(--ink); margin: 0; padding: 0; -unity-text-align: middle-left; max-width: 150px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.profile-pill__rank { font-size: 11px; -unity-font-style: bold; color: var(--mute); margin: 0; padding: 0; -unity-text-align: middle-left; }
.profile-pill__coins { flex-direction: row; align-items: center; }
.profile-pill__coins-text { font-size: 13px; -unity-font-style: bold; color: var(--accent); margin: 0; padding: 0; }
.coin--small { width: 12px; height: 12px; border-radius: 6px; margin-right: 5px; border-width: 2px; }

.avatar {
    width: 36px; height: 36px; border-radius: 18px; flex-shrink: 0; margin: 0; padding: 0;
    background-color: var(--player-1); color: #ffffff; font-size: 18px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.avatar--big { width: 64px; height: 64px; border-radius: 32px; font-size: 30px; }

/* Menu principal */
.btn--play { min-height: 80px; font-size: 30px; border-radius: 26px; margin-bottom: 14px; border-bottom-width: 8px; }
.main__row { flex-direction: row; }
.main__row .btn { font-size: 17px; }
.btn--purple { background-color: var(--player-1); color: var(--on-color); border-color: #5a37c4; }
.btn--purple:hover, .btn--purple:focus { background-color: var(--player-1); border-color: #5a37c4; }

/* Pantalla Jugar */
.play__group { font-size: 15px; -unity-font-style: bold; color: var(--mute); margin: 6px 0 8px 4px; }
.play__row { flex-direction: row; margin-bottom: 10px; }

.mode-card {
    flex-grow: 1; flex-basis: 0; height: 150px; margin: 0 5px; padding: 12px 12px 12px 14px;
    flex-direction: column; align-items: stretch; justify-content: flex-end;
    border-width: 0; border-bottom-width: 6px; border-radius: 22px; overflow: hidden;
}
.mode-card:active { translate: 0 4px; border-bottom-width: 2px; }
.mode-card__deco { position: absolute; right: -26px; top: -26px; width: 100px; height: 100px; border-radius: 50px; background-color: rgba(255,255,255,0.22); }
.mode-card__tag {
    position: absolute; left: 10px; top: 10px; padding: 2px 8px; border-radius: 10px;
    font-size: 11px; -unity-font-style: bold; background-color: rgba(0,0,0,0.28); color: #ffffff;
}
.mode-card__title { font-size: 20px; -unity-font-style: bold; margin: 0; padding: 0; -unity-text-align: middle-left; white-space: nowrap; }
.mode-card__subtitle { font-size: 12px; margin: 2px 0 0 0; padding: 0; opacity: 0.85; -unity-text-align: middle-left; white-space: normal; }

.mode-card--yellow { background-color: var(--accent); border-color: var(--accent-depth); color: var(--on-accent); }
.mode-card--yellow:hover, .mode-card--yellow:focus { background-color: var(--accent); border-color: var(--accent-depth); }
.mode-card--orange { background-color: #ff7a2f; border-color: #c4561a; color: #ffffff; }
.mode-card--orange:hover, .mode-card--orange:focus { background-color: #ff7a2f; border-color: #c4561a; }
.mode-card--blue { background-color: var(--blue); border-color: var(--blue-depth); color: #ffffff; }
.mode-card--blue:hover, .mode-card--blue:focus { background-color: var(--blue); border-color: var(--blue-depth); }
.mode-card--green { background-color: var(--green); border-color: var(--green-depth); color: var(--on-green); }
.mode-card--green:hover, .mode-card--green:focus { background-color: var(--green); border-color: var(--green-depth); }

/* Ajustes */
/* Las tarjetas van dentro del panel con scroll: un tono mas claro para distinguirlas */
.settings__scroll { margin-top: 12px; }
.settings__scroll .card { background-color: var(--card-2); border-color: var(--card-2-depth); }
.settings__scroll .unity-scroll-view__content-container { padding-right: 6px; }
.settings__profile { flex-direction: row; align-items: center; }
.settings__profile-info { margin-left: 14px; flex-shrink: 1; }
.settings__name { font-size: 22px; -unity-font-style: bold; color: var(--ink); margin: 0; padding: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.settings__status { font-size: 12px; color: var(--mute); margin: 0 0 6px 0; padding: 0; }
.settings__coins { flex-direction: row; align-items: center; }
.settings__hand { font-size: 17px; -unity-font-style: bold; color: var(--ink); margin: 0 0 10px 0; }

/* Tarjeta de Carrera del menu principal (acceso directo) */
.btn--orange { background-color: var(--player-0); color: var(--on-color); border-color: #c4561a; }
.btn--orange:hover, .btn--orange:focus { background-color: var(--player-0); border-color: #c4561a; }

/* Reparto vertical del menu: el espacio libre se reparte 2 : 3 : 4 : 3 entre
   barra-logo, logo-tarjeta, tarjeta-Jugar y el hueco de abajo (el grow de cada hueco es su "peso") */
.main__gap { flex-grow: 1; flex-shrink: 1; flex-basis: 0; min-height: 6px; }
.main__gap--top { flex-grow: 2; }
.main__gap--logo { flex-grow: 3; min-height: 12px; }
.main__gap--play { flex-grow: 4; min-height: 12px; }
.main__gap--bottom { flex-grow: 3; min-height: 0; }
.main__center { flex-shrink: 0; }
#screen-main .subtitle { margin-bottom: 0; }
.career-card {
    background-color: var(--card); border-width: 2px; border-bottom-width: 6px; border-color: var(--player-0);
    border-radius: 26px; margin: 0 2px; overflow: hidden;
}
.career-card__top {
    flex-direction: column; align-items: stretch; margin: 0; padding: 20px 18px 8px 18px;
    background-color: rgba(0,0,0,0); border-width: 0; border-radius: 0;
}
.career-card__top:hover, .career-card__top:focus { background-color: rgba(0,0,0,0); border-color: rgba(0,0,0,0); }
.career-card__top:active { opacity: 0.8; }

.career-card__head { flex-direction: row; align-items: center; justify-content: space-between; }
.career-card__kicker { font-size: 14px; -unity-font-style: bold; color: var(--mute); margin: 0; padding: 0; }
.career-card__tier {
    font-size: 12px; -unity-font-style: bold; color: #ffffff; background-color: var(--player-0);
    padding: 3px 10px; border-radius: 10px; margin: 0;
}

.career-card__body { flex-direction: row; align-items: center; margin: 18px 0; }
.career-card__badge {
    width: 76px; height: 76px; border-radius: 38px; flex-shrink: 0; margin: 0 16px 0 0; padding: 0;
    background-color: var(--player-0); color: #ffffff; font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.career-card__info { flex-grow: 1; flex-shrink: 1; }
.career-card__caption { font-size: 12px; color: var(--mute); margin: 0; padding: 0; -unity-text-align: middle-left; }
.career-card__opponent {
    font-size: 25px; -unity-font-style: bold; color: var(--ink); margin: 0; padding: 0; -unity-text-align: middle-left;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.career-card__reward { flex-direction: row; align-items: center; margin-top: 2px; }
.career-card__reward-text { font-size: 13px; -unity-font-style: bold; color: var(--accent); margin: 0; padding: 0; }

.career-card__track { height: 16px; border-radius: 8px; background-color: var(--field); }
.career-card__fill { height: 16px; border-radius: 8px; background-color: var(--green); width: 0; }
.career-card__progress { font-size: 12px; color: var(--mute); margin: 6px 0 0 0; padding: 0; -unity-text-align: middle-right; }

.btn.career-card__play { margin: 12px 18px 18px 18px; min-height: 64px; font-size: 22px; }

/* Inventario de manos */
.inv__count { font-size: 14px; -unity-font-style: bold; color: var(--mute); margin: 0; padding: 0; }

/* Aviso "Mano nueva" en el cuadro de victoria */
.gameover__hand {
    align-self: stretch; align-items: center; margin: 0 0 16px 0; padding: 12px;
    background-color: var(--card-2); border-width: 2px; border-color: var(--accent); border-radius: 22px;
    scale: 0.6 0.6; opacity: 0;
    transition-property: scale, opacity; transition-duration: 0.35s; transition-timing-function: ease-out-back;
}
.gameover__hand--in { scale: 1 1; opacity: 1; }
.gameover__hand-kicker { font-size: 14px; -unity-font-style: bold; color: var(--accent); margin: 0; }
.gameover__hand-img { width: 110px; height: 110px; margin: 8px 0; background-color: var(--field); border-radius: 18px; }
.gameover__hand-name { font-size: 22px; -unity-font-style: bold; color: var(--ink); margin: 0; }
.gameover__hand-note { font-size: 12px; color: var(--mute); margin: 2px 0 0 0; }

/* Pantalla de carga (los colores van fijos: se ve antes de cargar el tema) */
.loading {
    position: absolute; left: 0; right: 0; top: 0; bottom: 0;
    background-color: #150f3a; align-items: center; justify-content: center;
    transition-property: opacity; transition-duration: 0.35s;

}
.loading--hide { opacity: 0; }
.loading__c1 { position: absolute; width: 260px; height: 260px; border-radius: 130px; top: -90px; right: -80px; background-color: #2d2370; opacity: 0.55; }
.loading__c2 { position: absolute; width: 200px; height: 200px; border-radius: 100px; bottom: -70px; left: -80px; background-color: #2d2370; opacity: 0.55; }
.loading__logo { flex-direction: row; align-items: center; }
.loading__a { font-size: 52px; -unity-font-style: bold; color: #ffffff; margin: 0 10px 0 0; padding: 0; }
.loading__b { font-size: 52px; -unity-font-style: bold; color: #ffc83d; margin: 0; padding: 0; }
.loading__sub { font-size: 16px; color: #aaa0e6; margin: 2px 0 44px 0; }
.loading__track { width: 220px; height: 12px; border-radius: 6px; background-color: #2d2370; }
.loading__fill { width: 0; height: 12px; border-radius: 6px; background-color: #ffc83d; }
.loading__text { width: 140px; font-size: 15px; color: #aaa0e6; margin: 14px 0 0 0; -unity-text-align: middle-center; }
