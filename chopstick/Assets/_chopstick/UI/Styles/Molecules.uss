/* Moleculas: grupos pequenos de atomos */
.menu-btn { flex-direction: column; align-items: center; justify-content: center; }
.menu-btn__title { font-size: 17px; -unity-font-style: bold; color: var(--on-accent); }
.menu-btn__subtitle { font-size: 13px; -unity-font-style: normal; color: var(--on-accent); margin-top: 2px; white-space: normal; }

.seg { flex-direction: row; margin-bottom: 12px; }
.seg__item {
    flex-grow: 1; flex-basis: 0; min-height: 48px; margin: 0 4px; border-radius: 10px;
    background-color: rgba(0,0,0,0); color: var(--ink); border-width: 2px; border-color: var(--line);
    font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.seg__item--on { background-color: var(--accent); color: var(--on-accent); border-width: 0; }

.field { margin-bottom: 12px; }
.field__label { font-size: 15px; -unity-font-style: bold; color: var(--ink); margin-bottom: 6px; }
.field__input .unity-base-text-field__input,
.field__input .unity-text-field__input {
    background-color: var(--field); color: var(--ink); border-width: 2px; border-color: var(--line);
    border-radius: 10px; padding: 10px; font-size: 16px;
}
.check { margin: 4px 0 14px 0; }
.check .unity-label { color: var(--ink); font-size: 15px; }

.player-row { flex-direction: row; align-items: center; padding: 6px 0; }
.player-row__name { font-size: 16px; color: var(--ink); }

.hand {
    height: 124px; margin: 0 5px; padding: 8px 0;
    flex-direction: column; align-items: center; justify-content: flex-end;
    background-color: var(--field); border-width: 3px; border-color: var(--line); border-radius: 14px;
}
.hand--selected { background-color: var(--card); border-color: var(--accent); }
.hand--target { border-color: var(--ok); }
.hand--out { background-color: var(--out); }
.hand__fingers { flex-direction: row; align-items: flex-end; height: 50px; }
#hand-0 .hand__fingers { flex-direction: row-reverse; }
.hand__count { font-size: 19px; -unity-font-style: bold; color: var(--ink); }
