/* Moleculas: grupos pequenos de atomos */
.menu-btn { flex-direction: column; align-items: center; justify-content: center; }
.menu-btn__title { font-size: 19px; -unity-font-style: bold; }
.menu-btn__subtitle { font-size: 13px; -unity-font-style: normal; margin-top: 2px; white-space: normal; opacity: 0.85; }

/* Selector de dificultad: tres tarjetas con estrellas */
.seg { flex-direction: row; margin-bottom: 14px; }
.seg__item {
    flex-grow: 1; flex-basis: 0; margin: 0 4px; padding: 14px 4px; align-items: center;
    background-color: var(--card-2); color: var(--ink);
    border-width: 3px; border-color: var(--line); border-radius: 18px;
}
.seg__item--on { border-color: var(--accent); }
.seg__label { font-size: 17px; -unity-font-style: bold; -unity-text-align: middle-center; }
.stars { flex-direction: row; justify-content: center; margin-top: 12px; }
.star { width: 9px; height: 9px; margin: 0 4px; background-color: var(--accent); rotate: 45deg; }
.star--off { background-color: var(--switch-off); }

.field { margin-bottom: 12px; }
.field__label { font-size: 15px; -unity-font-style: bold; color: var(--mute); margin-bottom: 6px; }
.field__input .unity-base-text-field__input,
.field__input .unity-text-field__input {
    background-color: var(--field); color: var(--ink); border-width: 2px; border-color: var(--line);
    border-radius: 14px; padding: 12px; font-size: 17px; -unity-font-style: bold;
}

/* Casilla de marcar: toda la fila es un boton con la etiqueta a la izquierda y un cuadrado a la derecha */
.check {
    flex-direction: row; align-items: center; justify-content: space-between;
    background-color: rgba(0,0,0,0); border-width: 0; padding: 0; margin: 4px 0 14px 0;
}
.check:hover, .check:active, .check:focus { background-color: rgba(0,0,0,0); }
.check__label {
    flex-grow: 1; flex-shrink: 1; margin: 0; padding: 0; white-space: normal;
    font-size: 16px; -unity-font-style: bold; -unity-text-align: middle-left; color: var(--ink);
}
.check__box {
    width: 30px; height: 30px; margin-left: 12px; flex-shrink: 0;
    align-items: center; justify-content: center;
    background-color: var(--field); border-width: 3px; border-color: var(--line); border-radius: 9px;
}
/* La marca: dos bordes de un rectangulo girado forman un tick */
.check__tick {
    display: none; width: 8px; height: 15px; margin-top: -3px;
    border-right-width: 4px; border-bottom-width: 4px; border-color: #ffffff; rotate: 45deg;
}
.check--on .check__box { background-color: var(--green); border-color: var(--green-depth); }
.check--on .check__tick { display: flex; }

.player-row {
    flex-direction: row; align-items: center; padding: 12px; margin-bottom: 8px;
    background-color: var(--field); border-width: 2px; border-color: var(--line); border-radius: 16px;
}
.player-row .dot { width: 38px; height: 38px; border-radius: 19px; margin-right: 12px; }
.player-row__name { font-size: 17px; -unity-font-style: bold; color: var(--ink); }

.hand {
    height: 134px; margin: 0 5px; padding: 8px 0;
    flex-direction: column; align-items: center; justify-content: flex-end;
    background-color: var(--field); border-width: 3px; border-color: var(--line); border-radius: 18px;
}
.hand--selected { border-color: var(--accent); background-color: var(--card-2); }
.hand--target { border-color: var(--ok); }
.hand--out { background-color: var(--out); }
.hand__fingers { flex-direction: row; align-items: flex-end; height: 56px; }
#hand-0 .hand__fingers { flex-direction: row-reverse; }
.hand__count { font-size: 22px; -unity-font-style: bold; color: var(--ink); }
