/* Atomos: piezas minimas */
.card {
    background-color: var(--card); border-width: 2px; border-color: var(--line);
    border-radius: 22px; padding: 16px; margin-bottom: 16px;
}

/* Boton estilo juego: color vivo con borde inferior grueso que da relieve. Por defecto, amarillo. */
.btn {
    background-color: var(--accent); color: var(--on-accent);
    border-width: 0; border-bottom-width: 6px; border-color: var(--accent-depth);
    border-radius: 18px; min-height: 60px; padding: 12px 14px; margin: 0 0 12px 0;
    font-size: 19px; -unity-font-style: bold; -unity-text-align: middle-center;
}
.btn:active { translate: 0 4px; border-bottom-width: 2px; }
.btn:disabled { opacity: 0.45; }
/* Al pasar el dedo o el raton por encima, el boton mantiene sus colores (si no, Unity le pone un borde gris) */
.btn:hover, .btn:focus { background-color: var(--accent); border-color: var(--accent-depth); }
.btn--blue { background-color: var(--blue); color: var(--on-color); border-color: var(--blue-depth); }
.btn--green { background-color: var(--green); color: var(--on-green); border-color: var(--green-depth); }
.btn--ghost { background-color: var(--card-2); color: var(--ink); border-color: var(--card-2-depth); }
.btn--danger { background-color: var(--danger); color: var(--on-color); border-color: var(--danger-depth); }
.btn--blue:hover, .btn--blue:focus { background-color: var(--blue); border-color: var(--blue-depth); }
.btn--green:hover, .btn--green:focus { background-color: var(--green); border-color: var(--green-depth); }
.btn--ghost:hover, .btn--ghost:focus { background-color: var(--card-2); border-color: var(--card-2-depth); }
.btn--danger:hover, .btn--danger:focus { background-color: var(--danger); border-color: var(--danger-depth); }
.btn--half { flex-grow: 1; flex-basis: 0; }
.btn--gap { margin-right: 10px; }

.label-bold { font-size: 15px; -unity-font-style: bold; color: var(--mute); margin-bottom: 8px; }

.dot { width: 12px; height: 12px; border-radius: 6px; margin-right: 8px; background-color: var(--player-0); }
.badge {
    display: none; font-size: 11px; -unity-font-style: bold; color: #ffffff;
    background-color: var(--player-0); padding: 3px 10px; border-radius: 10px;
}
.tag {
    display: none; position: absolute; top: -12px; left: 50%; translate: -50% 0;
    font-size: 12px; -unity-font-style: bold; color: #ffffff; padding: 2px 10px; border-radius: 10px;
    background-color: var(--danger);
}
.finger {
    width: 15px; height: 52px; margin: 0 2px; background-color: var(--skin);
    border-width: 2px; border-color: var(--skin-line); border-radius: 8px 8px 3px 3px;
}
.finger--down { height: 22px; opacity: 1; border-radius: 8px; }
.palm {
    width: 84px; height: 18px; background-color: var(--skin);
    border-width: 2px; border-color: var(--skin-line); border-radius: 0 0 14px 14px;
}
.code { font-size: 48px; -unity-font-style: bold; letter-spacing: 14px; -unity-text-align: middle-center; color: var(--ink); margin: 6px 0; }
