/* Manos con dibujo (PNG) en la partida. En el rival se giran para que los dedos miren hacia abajo. */
.hand__sprite { width: 88px; height: 88px; -unity-background-scale-mode: scale-to-fit; }
#hand-0 .hand__sprite { scale: -1 1; }
.player-card--opponent .hand__sprite { scale: 1 -1; }
.player-card--opponent #hand-0 .hand__sprite { scale: -1 -1; }

/* Tienda: estilo "catalogo" con tarjetas cuadradas en cuadricula */
.shop__header { flex-direction: row; align-items: center; justify-content: space-between; margin: 4px 0 6px 0; }
.shop__title { font-size: 28px; -unity-font-style: bold; color: var(--ink); }

/* Monedas: siempre visibles arriba a la derecha */
.shop__coins {
    flex-direction: row; align-items: center;
    background-color: var(--card); border-width: 2px; border-bottom-width: 4px; border-color: var(--accent-depth); border-radius: 18px;
    padding: 3px 14px 3px 8px;
}
.coin {
    width: 22px; height: 22px; border-radius: 11px; margin-right: 8px; flex-shrink: 0;
    background-color: var(--accent); border-width: 3px; border-color: var(--accent-depth);
}
.shop__coins-text { font-size: 20px; -unity-font-style: bold; color: var(--accent); }

.shop__hint { font-size: 12px; color: var(--mute); -unity-text-align: middle-center; white-space: normal; margin: 0 6px 6px 6px; }

/* Leyenda de rarezas con su precio */
.shop__legend { flex-direction: row; flex-wrap: wrap; justify-content: center; margin: 0 0 6px 0; }
.legend-item { flex-direction: row; align-items: center; margin: 0 6px 2px 6px; }
.legend-item__dot { width: 9px; height: 9px; border-radius: 5px; margin-right: 4px; }
.legend-item__text { font-size: 11px; -unity-font-style: bold; color: var(--mute); }

/* Tono de piel: fila pequena */
.shop__skinrow { flex-direction: row; align-items: center; justify-content: center; margin: 0 0 8px 0; }
.shop__skinrow-label { font-size: 12px; -unity-font-style: bold; color: var(--mute); margin-right: 8px; }
.shop__tones { flex-direction: row; align-items: center; }
.tone-btn { width: 22px; height: 22px; min-height: 22px; margin: 0 3px; padding: 0; border-radius: 11px; border-width: 2px; }
.tone-btn--on { border-width: 3px; border-color: var(--accent); }

.shop__scroll .unity-scroll-view__content-container { padding: 8px 6px 12px 10px; }
.shop__grid { flex-direction: row; flex-wrap: wrap; }

/* Tarjeta cuadrada */
.skin-card {
    width: 31.3%; margin: 1%; padding: 6px 6px 7px 6px; flex-shrink: 0;
    background-color: var(--card-2); border-width: 2px; border-color: var(--card-2-depth); border-radius: 16px;
}
.skin-card:hover { border-color: var(--line); }
.skin-card--equipped { border-color: var(--ok); }
.skin-card--locked { opacity: 0.6; }
.skin-card__preview {
    width: 100%; height: 80px; flex-shrink: 0; align-items: center; justify-content: center;
    background-color: var(--field); border-radius: 12px;
}
.skin-card__sprite { width: 82%; height: 82%; flex-shrink: 0; }
.skin-card__rarity {
    position: absolute; top: 4px; right: 4px; width: 9px; height: 9px; border-radius: 5px;
    border-width: 1px; border-color: var(--field);
}
.skin-card__name { font-size: 12px; -unity-font-style: bold; color: var(--ink); margin: 6px 0 0 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.skin-card__desc { font-size: 9px; color: var(--mute); margin: 1px 0 5px 1px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.skin-card__status {
    flex-direction: row; align-items: center; justify-content: center;
    height: 22px; border-radius: 11px; background-color: var(--accent);
}
.skin-card__status-coin { width: 10px; height: 10px; border-radius: 5px; margin: 0 0 0 8px; flex-shrink: 0; background-color: var(--on-accent); opacity: 0.55; }
.skin-card__status-text {
    flex-grow: 1; margin: 0; padding: 0; height: 100%;
    font-size: 11px; -unity-font-style: bold; color: var(--on-accent);
    -unity-text-align: middle-center; white-space: nowrap;
}
.skin-card__status--equipped { background-color: var(--green); }
.skin-card__status--equipped .skin-card__status-text { color: var(--on-green); }
.skin-card__status--owned { background-color: var(--blue); }
.skin-card__status--owned .skin-card__status-text { color: var(--on-color); }
.skin-card__status--locked { background-color: var(--card-2-depth); }
.skin-card__status--locked .skin-card__status-text { color: var(--mute); }

/* Mano de respaldo si falta el PNG */
.mini-hand { width: 60%; height: 80%; align-items: center; justify-content: flex-end; }
.mini-hand__fingers { flex-direction: row; justify-content: space-between; width: 100%; height: 55%; align-items: flex-end; }
.mini-hand__finger { width: 21%; border-radius: 6px 6px 0 0; border-width: 2px; }
.mini-hand__palm { width: 100%; height: 40%; border-radius: 4px 4px 12px 12px; border-width: 2px; margin-top: -2px; }

/* Ventana con el detalle de un estilo (al tocar una tarjeta) */
.skin-detail__box {
    background-color: var(--card); border-width: 3px; border-color: var(--accent);
    border-radius: 30px; padding: 20px 22px 16px 22px;
}
.skin-detail__rarity { font-size: 13px; -unity-font-style: bold; -unity-text-align: middle-center; margin-bottom: 10px; }
.skin-detail__preview {
    width: 200px; height: 200px; max-width: 100%; align-self: center; flex-shrink: 0;
    align-items: center; justify-content: center;
    background-color: var(--field); border-radius: 22px;
}
.skin-detail__sprite { width: 88%; height: 88%; flex-shrink: 0; }
.skin-detail__name { font-size: 28px; -unity-font-style: bold; color: var(--ink); -unity-text-align: middle-center; white-space: normal; margin: 14px 0 0 0; }
.skin-detail__desc { font-size: 15px; color: var(--mute); -unity-text-align: middle-center; white-space: normal; margin: 4px 0 8px 0; }
.skin-detail__note { font-size: 13px; color: var(--mute); -unity-text-align: middle-center; white-space: normal; margin: 0 0 12px 0; min-height: 16px; }

/* Boton Tienda del menu principal */
#btn-shop .btn { background-color: var(--accent); color: var(--on-accent); border-color: var(--accent-depth); }
