/* Organismos: bloques completos */
.turn-banner {
    align-self: center; align-items: center; padding: 10px 28px; margin-bottom: 12px;
    border-radius: 26px; border-bottom-width: 5px; border-color: rgba(0,0,0,0.28);
    background-color: var(--green);
}
.turn-banner__title { font-size: 20px; -unity-font-style: bold; color: #ffffff; }
.turn-banner__hint { font-size: 13px; color: #ffffff; margin-top: 1px; white-space: normal; -unity-text-align: middle-center; }
.turn-banner--wait { opacity: 0.75; }

.player-card {
    background-color: var(--card); border-width: 3px; border-color: var(--line);
    border-radius: 24px; padding: 14px 12px 12px 12px; margin-bottom: 14px;
}
.player-card--turn { border-color: var(--ok); }
.player-card--dead { opacity: 0.35; }
.player-card__header { flex-direction: row; align-items: center; margin-bottom: 14px; padding: 0 4px; }
.player-card__name { flex-grow: 1; font-size: 16px; -unity-font-style: bold; color: var(--ink); }
.player-card__hands { flex-direction: row; }
.rank-tag {
    font-size: 11px; -unity-font-style: bold; color: var(--accent); background-color: var(--field);
    border-radius: 9px; padding: 2px 8px; margin: 0 6px 0 0; flex-shrink: 0;
}
.player-card__hands > TemplateContainer { flex-grow: 1; flex-basis: 0; }
/* Rival: manos giradas, con los dedos hacia abajo */
.player-card--opponent .hand { flex-direction: column-reverse; }
.player-card--opponent .hand__fingers { align-items: flex-start; }
.player-card--opponent .finger { border-radius: 3px 3px 8px 8px; }
.player-card--opponent .palm { border-radius: 14px 14px 0 0; }

/* Fila de botones de los ajustes: uno debajo del otro */
.action-row { flex-direction: column; }
.action-row .btn { flex-grow: 0; flex-basis: auto; margin-right: 0; }

.vs-badge {
    align-self: center; width: 46px; height: 46px; border-radius: 23px;
    background-color: var(--danger); border-bottom-width: 4px; border-color: var(--danger-depth);
    align-items: center; justify-content: center; margin: -4px 0 8px 0;
}
.vs-badge__text { font-size: 17px; -unity-font-style: bold; color: #ffffff; }
