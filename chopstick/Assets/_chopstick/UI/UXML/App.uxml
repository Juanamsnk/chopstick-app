<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <ui:Style src="/Assets/_chopstick/UI/Styles/Main.uss" />
  <ui:Template name="MainMenu" src="/Assets/_chopstick/UI/UXML/Screens/MainMenu.uxml" />
  <ui:Template name="PlayMenu" src="/Assets/_chopstick/UI/UXML/Screens/PlayMenu.uxml" />
  <ui:Template name="Settings" src="/Assets/_chopstick/UI/UXML/Screens/Settings.uxml" />
  <ui:Template name="OfflineSetup" src="/Assets/_chopstick/UI/UXML/Screens/OfflineSetup.uxml" />
  <ui:Template name="AiSetup" src="/Assets/_chopstick/UI/UXML/Screens/AiSetup.uxml" />
  <ui:Template name="Career" src="/Assets/_chopstick/UI/UXML/Screens/Career.uxml" />
  <ui:Template name="Shop" src="/Assets/_chopstick/UI/UXML/Screens/Shop.uxml" />
  <ui:Template name="Inventory" src="/Assets/_chopstick/UI/UXML/Screens/Inventory.uxml" />
  <ui:Template name="Friends" src="/Assets/_chopstick/UI/UXML/Screens/Friends.uxml" />
  <ui:Template name="OnlineMenu" src="/Assets/_chopstick/UI/UXML/Screens/OnlineMenu.uxml" />
  <ui:Template name="Lobby" src="/Assets/_chopstick/UI/UXML/Screens/Lobby.uxml" />
  <ui:Template name="Game" src="/Assets/_chopstick/UI/UXML/Screens/Game.uxml" />
  <ui:Template name="Searching" src="/Assets/_chopstick/UI/UXML/Screens/Searching.uxml" />
  <ui:VisualElement name="app" class="app theme-dark">
    <ui:Instance template="MainMenu" name="mainmenu" />
    <ui:Instance template="PlayMenu" name="playmenu" style="display:none;" />
    <ui:Instance template="Settings" name="settings" style="display:none;" />
    <ui:Instance template="OfflineSetup" name="offlinesetup" style="display:none;" />
    <ui:Instance template="AiSetup" name="aisetup" style="display:none;" />
    <ui:Instance template="Career" name="career" style="display:none;" />
    <ui:Instance template="Shop" name="shop" style="display:none;" />
    <ui:Instance template="Inventory" name="inventory" style="display:none;" />
    <ui:Instance template="Friends" name="friends" style="display:none;" />
    <ui:Instance template="OnlineMenu" name="onlinemenu" style="display:none;" />
    <ui:Instance template="Lobby" name="lobby" style="display:none;" />
    <ui:Instance template="Game" name="game" style="display:none;" />
    <ui:Instance template="Searching" name="searching" style="display:none;" />
    <ui:VisualElement name="challenge" class="overlay overlay--center" style="display:none;">
      <ui:VisualElement class="gameover__box">
        <ui:Label text="¡Reto!" class="gameover__title" />
        <ui:Label name="challenge-text" text="" class="gameover__text" />
        <ui:Button name="btn-challenge-accept" text="Aceptar" class="btn" />
        <ui:Button name="btn-challenge-decline" text="Rechazar" class="btn btn--ghost" />
      </ui:VisualElement>
    </ui:VisualElement>
  </ui:VisualElement>
  <ui:VisualElement name="loading" class="loading">
    <ui:VisualElement class="loading__c1" picking-mode="Ignore" />
    <ui:VisualElement class="loading__c2" picking-mode="Ignore" />
    <ui:VisualElement class="loading__logo" picking-mode="Ignore">
      <ui:Label text="Chop" class="loading__a" />
      <ui:Label text="5ticks" class="loading__b" />
    </ui:VisualElement>
    <ui:Label text="El duelo de dedos" class="loading__sub" />
    <ui:VisualElement class="loading__track">
      <ui:VisualElement name="loading-fill" class="loading__fill" />
    </ui:VisualElement>
    <ui:Label name="loading-text" text="Cargando" class="loading__text" />
  </ui:VisualElement>
</ui:UXML>
