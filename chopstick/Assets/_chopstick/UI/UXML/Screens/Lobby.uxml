<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="ActionRow" src="project://database/Assets/_chopstick/UI/UXML/Organisms/ActionRow.uxml?fileID=9197481963319205126&amp;guid=c27cb44d1b141f54daab524807ad74bb&amp;type=3#ActionRow"/>
    <ui:Template name="BgDecor" src="project://database/Assets/_chopstick/UI/UXML/Molecules/BgDecor.uxml?fileID=9197481963319205126&amp;guid=e7d4d788b246677499e0bb0c2d55fa53&amp;type=3#BgDecor"/>
    <ui:Template name="PlayerRow" src="project://database/Assets/_chopstick/UI/UXML/Molecules/PlayerRow.uxml?fileID=9197481963319205126&amp;guid=3a8c6cf46cea6b844b4349823dc2188f&amp;type=3#PlayerRow"/>
    <Style src="project://database/Assets/_chopstick/UI/Styles/Main.uss?fileID=7433441132597879392&amp;guid=815dab59b3928334790fa7ef335b965f&amp;type=3#Main"/>
    <ui:VisualElement name="screen-lobby" class="screen">
        <ui:Instance template="BgDecor" name="decor" picking-mode="Ignore"/>
        <ui:VisualElement class="logo">
            <ui:Label text="Chop" class="logo__a"/>
            <ui:Label text="5ticks" class="logo__b"/>
        </ui:VisualElement>
        <ui:Label text="El duelo de dedos" class="subtitle"/>
        <ui:VisualElement class="card">
            <ui:Label text="Código de la partida" class="label-bold"/>
            <ui:Label name="code" text="----" class="code"/>
            <ui:Label text="Comparte este código con tu rival para que se una a la partida." class="lobby__info"/>
        </ui:VisualElement>
        <ui:VisualElement name="player-list">
            <ui:Instance template="PlayerRow" name="row-0">
                <AttributeOverrides element-name="name" text="Jugador 1 (anfitrión)"/>
            </ui:Instance>
            <ui:Instance template="PlayerRow" name="row-1">
                <AttributeOverrides element-name="name" text="Jugador 2"/>
            </ui:Instance>
        </ui:VisualElement>
        <ui:VisualElement class="spacer"/>
        <ui:Instance template="ActionRow" name="action-row">
            <AttributeOverrides element-name="btn-primary" text="Empezar (1/2)"/>
            <AttributeOverrides element-name="btn-secondary" text="Salir"/>
        </ui:Instance>
    </ui:VisualElement>
</ui:UXML>
