<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
  <ui:Style src="/Assets/_chopstick/UI/Styles/Main.uss" />
  <ui:Template name="BgDecor" src="/Assets/_chopstick/UI/UXML/Molecules/BgDecor.uxml" />
  <ui:Template name="PlayerRow" src="/Assets/_chopstick/UI/UXML/Molecules/PlayerRow.uxml" />
  <ui:Template name="ActionRow" src="/Assets/_chopstick/UI/UXML/Organisms/ActionRow.uxml" />
  <ui:VisualElement name="screen-lobby" class="screen">
    <ui:Instance template="BgDecor" name="decor" picking-mode="Ignore" />
    <ui:VisualElement class="logo">
      <ui:Label text="Chop" class="logo__a" />
      <ui:Label text="sticks" class="logo__b" />
    </ui:VisualElement>
    <ui:Label text="El duelo de dedos" class="subtitle" />
    <ui:VisualElement class="card">
      <ui:Label text="Código de la partida" class="label-bold" />
      <ui:Label name="code" text="----" class="code" />
      <ui:Label text="Comparte este código con tu rival para que se una a la partida." class="lobby__info" />
    </ui:VisualElement>
    <ui:VisualElement name="player-list">
      <ui:Instance template="PlayerRow" name="row-0">
        <ui:AttributeOverrides element-name="name" text="Jugador 1 (anfitrión)" />
      </ui:Instance>
      <ui:Instance template="PlayerRow" name="row-1">
        <ui:AttributeOverrides element-name="name" text="Jugador 2" />
      </ui:Instance>
    </ui:VisualElement>
    <ui:VisualElement class="spacer" />
    <ui:Instance template="ActionRow" name="action-row">
      <ui:AttributeOverrides element-name="btn-primary" text="Empezar (1/2)" />
      <ui:AttributeOverrides element-name="btn-secondary" text="Salir" />
    </ui:Instance>
  </ui:VisualElement>
</ui:UXML>
