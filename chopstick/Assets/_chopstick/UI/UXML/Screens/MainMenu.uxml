<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Template name="BgDecor" src="/Assets/_chopstick/UI/UXML/Molecules/BgDecor.uxml" />
    <Style src="/Assets/_chopstick/UI/Styles/Main.uss" />
    <ui:VisualElement name="screen-main" class="screen">
        <ui:Instance template="BgDecor" name="decor" picking-mode="Ignore"/>
        <ui:VisualElement class="topbar">
            <ui:Button name="btn-profile" class="profile-pill">
                <ui:Label name="avatar" text="?" class="avatar" picking-mode="Ignore"/>
                <ui:VisualElement class="profile-pill__info" picking-mode="Ignore">
                    <ui:Label name="profile-name" text="Invitado" class="profile-pill__name" picking-mode="Ignore"/>
                    <ui:Label name="profile-rank" text="" class="profile-pill__rank" picking-mode="Ignore"/>
                    <ui:VisualElement class="profile-pill__coins" picking-mode="Ignore">
                        <ui:VisualElement class="coin coin--small" picking-mode="Ignore"/>
                        <ui:Label name="profile-coins" text="0" class="profile-pill__coins-text" picking-mode="Ignore"/>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:Button>
            <ui:Button name="btn-settings" text="Ajustes" class="topbar__btn"/>
        </ui:VisualElement>
        <ui:VisualElement class="logo">
            <ui:Label text="Chop" name="Label" class="logo__a"/>
            <ui:Label text="5ticks" class="logo__b"/>
        </ui:VisualElement>
        <ui:Label text="El duelo de dedos" class="subtitle"/>
        <ui:VisualElement class="spacer"/>
        <ui:Button name="btn-play" text="Jugar" class="btn btn--play"/>
        <ui:VisualElement class="main__row">
            <ui:Button name="btn-shop" text="Tienda" class="btn btn--blue btn--half btn--gap"/>
            <ui:Button name="btn-friends" text="Amigos" class="btn btn--green btn--half"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
